# ── Anthropic / Claude ─────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model to use for sentiment analysis (default: claude-haiku-4-5)
CLAUDE_MODEL=claude-haiku-4-5

# Only analyse texts longer than this many characters
CLAUDE_MIN_TEXT_LENGTH=20

# ── YouTube Data API v3 ────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
YOUTUBE_API_KEY=

# ── Facebook (Playwright + login) ──────────────────────────────────────────
# Required — used to log in and access pages + public groups.
# Session is saved to .fb_session/state.json after first login.
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///byd_perception.db

# ── Crawler tuning ─────────────────────────────────────────────────────────
REQUEST_DELAY=2.0          # base seconds between HTTP requests
MAX_RETRIES=3

YOUTUBE_MAX_RESULTS=50
YOUTUBE_MAX_COMMENT_PAGES=5

FACEBOOK_MAX_POSTS=50
# Only fetch the comment page when a post has at least this many comments
FACEBOOK_MIN_COMMENTS=3
